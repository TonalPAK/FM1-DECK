<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Optional features: the app runs without them, uses them when present. -->
    <uses-feature android:name="android.hardware.audio.low_latency" android:required="false" />
    <uses-feature android:name="android.hardware.audio.pro" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen.multitouch.jazzhand" android:required="false" />
    <uses-feature android:name="android.software.midi" android:required="false" />

    <!-- Permissions are added by the phase that needs them (docs/ROADMAP.md):
         P3 INTERNET (user-initiated update check), P8 INTERNET + ACCESS_WIFI_STATE (Wi-Fi drop),
         P8 FOREGROUND_SERVICE + FOREGROUND_SERVICE_MEDIA_PLAYBACK + POST_NOTIFICATIONS (play in background),
         P9 BLUETOOTH_SCAN / BLUETOOTH_CONNECT (BLE MIDI). -->

    <!-- P9a Ableton Link (docs/LINK.md): UDP on the local network, only after the user switches Link on.
         Link finds its peers by multicast, which Android filters unless a multicast lock is held. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.FM1Deck">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
